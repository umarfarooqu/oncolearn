# OncoLearn Environment Variables
# Copy this file to .env and update values as needed

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
# PORT is automatically set by Railway/Heroku/Render
# Leave blank on deployment platforms (they override it)
# Local development: PORT=5000
PORT=5000
HOST=0.0.0.0

# Applications Settings
MAX_CONTENT_SIZE=16777216
